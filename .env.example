# Environment Configuration for Instagram Specialist Agent

# Web Search & Browser APIs
AIRTOP_API_KEY=your_airtop_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Reasoning, Vision & Image APIs
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here
POLLINATIONS_API_KEY=your_pollinations_api_key_here

# Writing Provider (Defaults to Gemini / Mock; can be overridden)
WRITING_PROVIDER_API_KEY=your_writing_provider_key_here

# Instagram Graph API Credentials (Optional)
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id_here

# Server Port (default: 5002)
PORT=5002
